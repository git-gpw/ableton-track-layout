{
  "name": "set-template",
  "displayName": "Set Template",
  "version": "0.1.0",
  "description": "Save and restore track layouts as reusable templates in Ableton Live",
  "type": "commonjs",
  "main": "dist/extension.js",
  "scripts": {
    "start": "extensions-cli run --live '/Applications/Ableton Live 12 Beta.app'",
    "build": "tsc --noEmit && node esbuild.js",
    "build:prod": "tsc --noEmit && node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "test": "vitest run"
  },
  "keywords": [
    "ableton",
    "ableton-extensions",
    "ableton-live",
    "template",
    "tracks"
  ],
  "license": "MIT",
  "dependencies": {
    "@ableton-extensions/sdk": "file:./ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
